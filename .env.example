# Copy to .env.local for local development. Never commit .env.local.
# Find these in Supabase: Project Settings > API Keys (publishable key)
# and Project Settings > Data API (project URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# AI video processing (server-only; never prefix with NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
# LESSON_AI_MODEL=claude-opus-5-5
